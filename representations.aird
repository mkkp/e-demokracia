        <children xmi:type="notation:Shape" xmi:id="_MSywwIXpEe2kLcMqsIbMgQ" type="Note" fontName=".AppleSystemUIFont" description="Nem tudom szukseg van-e erre a bontasra. Azert igy csinaltam, mert nem tudom eleg-e a usernel a varos meghatarozas, vagy mindenkeppen midnen usernel a Korzet keruljon definialasra. Amennyiben minden varoshoz csinalunk legalabb 1 korzetet es az a mondas hogy korzet szintet lehet csak megadni User-hez, akkor csak a District kell - mivel a District meghatarozza a Varost es a Megye-t. A County vagy City meghatarozas azokra a helyisegekre vonatkozik, mikor ne ismerjuk a reszletesebb bontast a usernel" fillColor="13369343" transparency="0" lineColor="6737151" lineWidth="1">
          <eAnnotations xmi:type="ecore:EAnnotation" xmi:id="_MSywwYXpEe2kLcMqsIbMgQ" source="specificStyles">
            <details xmi:type="ecore:EStringToStringMapEntry" xmi:id="_MSywwoXpEe2kLcMqsIbMgQ" key="verticalAlignment" value="8"/>
          </eAnnotations>
          <children xmi:type="notation:BasicDecorationNode" xmi:id="_MSywxoXpEe2kLcMqsIbMgQ" type="DiagramName">
            <element xsi:nil="true"/>
          </children>
