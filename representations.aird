          <styles xmi:type="notation:LineTypeStyle" xmi:id="_MSywxIXpEe2kLcMqsIbMgQ"/>
          <element xsi:nil="true"/>
          <layoutConstraint xmi:type="notation:Bounds" xmi:id="_MSywxYXpEe2kLcMqsIbMgQ" x="360" y="624" width="455"/>
        </children>
        <children xmi:type="notation:Shape" xmi:id="_ExRf8IdxEe2kLcMqsIbMgQ" type="Note" fontName=".AppleSystemUIFont" description="Szerepkoroket tisztazni. Eddig az Admin lett megkulonboztetve. A usernel a kulonbozo szerepkorok bepipalhatoak lesznek, ha az ugy OK. (Mint az isAdmin)" fillColor="13369343" transparency="0" lineColor="6737151" lineWidth="1">
