    <eOperations xmi:id="(psm/(esm/_75dqsI1jEe2J66C5CrhpQw)/InPlaceUnboundOperation)/UnboundOperation" name="initCategories">
      <eAnnotations xmi:id="(psm/(esm/_75dqsI1jEe2J66C5CrhpQw)/InPlaceUnboundOperation)/BoundOperationAnnotation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/bound">
        <details xmi:id="(psm/(esm/_75dqsI1jEe2J66C5CrhpQw)/InPlaceUnboundOperation)/BoundOperationAnnotation/Bound" key="value" value="false"/>
      </eAnnotations>
