        <details xmi:id="(psm/(esm/_75dqsI1jEe2J66C5CrhpQw)/InPlaceUnboundOperation)/ScriptBodyAnnotation/Body" key="body" value="var edemokracia::IssueCategory szocialis_kerdesek = edemokracia::IssueCategory!filter(c | c.title == &quot;Szociális kérdések&quot;)!any();&#xA;if (szocialis_kerdesek!isUndefined()) {&#xA;&#x9;szocialis_kerdesek = new edemokracia::IssueCategory(title = &quot;Szociális kérdések&quot;, description = &quot;Szociális kérdések&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory oktatas = edemokracia::IssueCategory!filter(c | c.title == &quot;Oktatás&quot;)!any();&#xA;if (oktatas!isUndefined()) {&#xA;&#x9;oktatas = new edemokracia::IssueCategory(title = &quot;Oktatás&quot;, description = &quot;Oktatás&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory egeszsegugy = edemokracia::IssueCategory!filter(c | c.title == &quot;Egészségügy&quot;)!any();&#xA;if (egeszsegugy!isUndefined()) {&#xA;&#x9;egeszsegugy = new edemokracia::IssueCategory(title = &quot;Egészségügy&quot;, description = &quot;Egészségügy&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory kornyezetvedelem = edemokracia::IssueCategory!filter(c | c.title == &quot;Környezetvédelem&quot;)!any();&#xA;if (kornyezetvedelem!isUndefined()) {&#xA;&#x9;kornyezetvedelem = new edemokracia::IssueCategory(title = &quot;Környezetvédelem&quot;, description = &quot;Környezetvédelem&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory kultura = edemokracia::IssueCategory!filter(c | c.title == &quot;Kultúra&quot;)!any();&#xA;if (kultura!isUndefined()) {&#xA;&#x9;kultura = new edemokracia::IssueCategory(title = &quot;Kultúra&quot;, description = &quot;Kultúra&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory gazdasag = edemokracia::IssueCategory!filter(c | c.title == &quot;Gazdaság&quot;)!any();&#xA;if (gazdasag!isUndefined()) {&#xA;&#x9;gazdasag = new edemokracia::IssueCategory(title = &quot;Gazdaság&quot;, description = &quot;Gazdaság&quot;);&#xA;}&#xA;&#xA;var edemokracia::IssueCategory ene