      <eAnnotations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/InstanceRepresentationOfBoundOperation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/instanceRepresentation">
        <details xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/InstanceRepresentationOfBoundOperation/InstanceRepresentation" key="value" value="edemokracia._default_transferobjecttypes.Debate"/>
      </eAnnotations>
      <eAnnotations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/BoundOperationAnnotation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/bound">
        <details xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/BoundOperationAnnotation/Bound" key="value" value="true"/>
      </eAnnotations>
      <eAnnotations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/ScriptBodyAnnotationForBoundOperation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/script">
        <details xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/ScriptBodyAnnotation/Body" key="body" value="var edemokracia::VoteDefinition voteDef;&#xA;&#xA;if (input.voteType == edemokracia::VoteTypeOnCloseDebate#YES_NO) {&#xA;&#x9;voteDef = new edemokracia::YesNoVoteDefinition(&#xA;&#x9;&#x9;title = input.title, &#xA;&#x9;&#x9;description = input.description,&#xA;&#x9;&#x9;closeAt = input.closeAt,&#xA;&#x9;&#x9;status = edemokracia::VoteStatus#CREATED&#xA;&#x9;);&#xA;}&#xA;&#xA;if (input.voteType == edemokracia::VoteTypeOnCloseDebate#YES_NO_ABSTAIN) {&#xA;&#x9;voteDef = new edemokracia::YesNoAbstainVoteDefinition(&#xA;&#x9;&#x9;title = input.title, &#xA;&#x9;&#x9;description = input.description,&#xA;&#x9;&#x9;closeAt = input.closeAt,&#xA;&#x9;&#x9;status = edemokracia::VoteStatus#CREATED&#x9;&#x9;&#xA;&#x9;);&#xA;}&#xA;&#xA;if (input.voteType == edemokracia::VoteTypeOnCloseDebate#SELECT_ANSWER) {&#xA;&#x9;var edemokracia::SelectAnswerVoteDefinition selectVoteDef = new edemokracia::SelectAnswerVoteDefinition(&#xA;&#x9;&#x9;title = input.title, &#xA;&#x9;&#x9;description = input.description,&#xA;&#x9;&#x9;closeAt = input.closeAt,&#xA;&#x9;&#x9;status = edemokracia::VoteStatus#CREATED&#x9;&#x9;&#xA;&#x9;);&#xA;&#x9;&#xA;&#x9;for (answer in input.answers) {&#xA;&#x9;&#x9;var edemokracia::SelectAnswerVoteSelection voteSelection = new edemokracia::SelectAnswerVoteSelection(&#xA;&#x9;&#x9;&#x9;title = answer.title,&#xA;&#x9;&#x9;&#x9;description = answer.description&#xA;&#x9;&#x9;);&#xA;&#x9;&#x9;selectVoteDef.voteSelections += voteSelection;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;voteDef = selectVoteDef;&#xA;}&#xA;&#xA;if (input.voteType == edemokracia::VoteTypeOnCloseDebate#RATE) {&#xA;&#x9;voteDef = new edemokracia::RatingVoteDefinition(&#xA;&#x9;&#x9;title = input.title, &#xA;&#x9;&#x9;description = input.description,&#xA;&#x9;&#x9;closeAt = input.closeAt,&#xA;&#x9;&#x9;status = edemokracia::VoteStatus#CREATED&#x9;&#x9;&#xA;&#x9;);&#xA;}&#xA;&#xA;this.debateVote = voteDef;&#xA;&#xA;this.status = edemokracia::DebateStatus#CLOSED;&#xA;&#xA;return voteDef;&#xA; "/>
      </eAnnotations>
      <eParameters xmi:id="(psm/(esm/_dymMoG6JEe2wNaja8kBvcQ)/Parameter)/InputParameter" name="input" lowerBound="1" eType="(psm/(esm/_NGvTUG6JEe2wNaja8kBvcQ)/UnmappedTransferObjectType)/UnmappedTransferObject"/>
    </eOperations>
