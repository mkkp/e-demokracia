        <details xmi:id="(psm/(esm/_5rSi8I1jEe2J66C5CrhpQw)/InPlaceUnboundOperation)/ScriptBodyAnnotation/Body" key="body" value="&#xA;&#xA;// TODO: Create superadmin user&#xA;var edemokracia::admin::AdminPrincipalUser admin = edemokracia::admin::AdminPrincipalUser!filter(u | u.userName == &quot;admin&quot;)!any();&#xA;&#xA;if (admin!isUndefined()) {&#xA;&#x9;new edemokracia::admin::AdminPrincipalUser(&#xA;&#x9;    userName = &quot;admin&quot;,&#xA;&#x9;    firstName = &quot;Test&quot;,&#xA;&#x9;    lastName = &quot;Elek&quot;,&#xA;&#x9;    isAdmin = true,&#xA;&#x9;    email = &quot;test@mkkp.party&quot;&#xA;    )&#xA;}&#xA;"/>
