      <eAnnotations xmi:id="(psm/(esm/_ezy40HW5Ee2LTNnGda5kaw)/BoundOperation)/ScriptBodyAnnotationForBoundOperation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/script">
        <details xmi:id="(psm/(esm/_ezy40HW5Ee2LTNnGda5kaw)/BoundOperation)/ScriptBodyAnnotation/Body" key="body" value="var edemokracia::User user = edemokracia::User!filter(u | u.userName == edemokracia::types::String!getVariable(&quot;ACTOR&quot;, &quot;userName&quot;))!any()&#xA;&#xA;if (input.type == edemokracia::CreateArgumentInputType#CON) {&#xA;&#x9;this.cons += new edemokracia::Con(createdBy = user, title = input.title, description = input.description);&#xA;}&#xA;if (input.type == edemokracia::CreateArgumentInputType#PRO) {&#xA;&#x9;this.pros += new edemokracia::Pro(createdBy = user, title = this.title, description = input.description);&#xA;}&#xA;"/>
      </eAnnotations>
      <eParameters xmi:id="(psm/(esm/_nJbuEHW5Ee2LTNnGda5kaw)/Parameter)/InputParameter" name="input" lowerBound="1" eType="(psm/(esm/_GaaTIHW5Ee2LTNnGda5kaw)/UnmappedTransferObjectType)/UnmappedTransferObject"/>
