      <eAnnotations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/CustomImplementationAnnotationOnBoundOperation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/customImplementation">
        <details xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/CustomImplementationAnnotationOnBoundOperation/CustomImplementation" key="value" value="false"/>
