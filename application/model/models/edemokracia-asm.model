    <eOperations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/BoundOperation" name="closeDebate" lowerBound="1" eType="(psm/(esm/_0n43QG5mEe2wNaja8kBvcQ)/DefaultMappedTransferObjectTypeForEntity)/MappedTransferObject">
      <eAnnotations xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/OutputParameterName" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/outputParameterName">
        <details xmi:id="(psm/(esm/_e_vckG6GEe2wNaja8kBvcQ)/BoundOperation)/OutputParameterName/Name" key="value" value="output"/>
