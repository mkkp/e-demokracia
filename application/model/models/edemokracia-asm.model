        <eAnnotations xmi:id="(psm/(esm/_wJkIYIyPEe2VSOmaAz6G9Q)/InPlaceUnboundOperation)/BoundOperationAnnotation" source="http://blackbelt.hu/judo/meta/ExtendedMetadata/bound">
